# OpenAI: script generation (GPT-4o), TTS voiceover, Whisper caption timing
OPENAI_API_KEY=

# Replicate: FLUX image generation
REPLICATE_API_TOKEN=

# Google/YouTube OAuth (from CF-1: Google Cloud OAuth app + YouTube test channel)
# Single hardcoded channel for this demo - no per-tenant account storage.
# Pull client_id/client_secret from the "installed" object in the OAuth client
# JSON Google Cloud Console gives you when you create a Desktop app credential -
# no redirect URI needed here, google-auth-oauthlib's InstalledAppFlow runs its
# own local loopback server and handles that automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
